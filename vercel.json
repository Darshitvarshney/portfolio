{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "installCommand": "npm install",
  "routes": [
    {
      "src": "/(.*\\.pdf)",
      "headers": {
        "content-type": "application/pdf",
        "content-disposition": "attachment; filename=Darshit_Varshney_Resume.pdf"
      },
      "dest": "/$1"
    },
    {
      "src": "^/(assets/.*|.*\\.(js|css|png|jpg|jpeg|svg|ico|pdf|webp|txt|woff|woff2|json))$",
      "dest": "/$1"
    },
    {
      "handle": "filesystem"
    },
    {
      "src": "/(.*)",
      "dest": "/index.html"
    }
  ]
}
